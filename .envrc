#!/usr/bin/env bash

# Check if mise is available and activate it
if command -v mise >/dev/null 2>&1; then
    eval "$(mise env -s bash)"
    echo "✓ mise environment activated"
else
    echo "⚠ mise not found - install from https://mise.jdx.dev/"
fi

# Set common environment variables for the project
# Point envtest at the binaries for the Makefile's ENVTEST_K8S_VERSION, so
# ginkgo can run without make. Run `make test` once to download them.
envtest_version="$(sed -n 's/^ENVTEST_K8S_VERSION = //p' Makefile)"
if envtest_assets="$(setup-envtest use -i "${envtest_version}" --bin-dir "${PWD}/bin" -p path 2>/dev/null)"; then
    export KUBEBUILDER_ASSETS="${envtest_assets}"
fi
export GINKGO_OPTIONS="-v --skip-package test/e2e -coverprofile cover.out -coverpkg ./api/v1/...,./internal/... -r"

# Add local bin directory to PATH for locally installed tools
export PATH="${PWD}/bin:${PATH}"