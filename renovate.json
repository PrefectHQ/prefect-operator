{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>PrefectHQ/renovate-config",
    "github>PrefectHQ/renovate-config:go",
    "github>PrefectHQ/renovate-config:helm",
    "helpers:pinGitHubActionDigests"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Update the go directive in go.mod. By default, Renovate does not propose updates to it.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Update the golang version in .mise.toml and the go directive in go.mod in the same PR. CI installs Go from .mise.toml, so go.mod must not require a newer Go than .mise.toml.",
      "matchManagers": [
        "gomod",
        "mise"
      ],
      "matchDepNames": [
        "go",
        "golang"
      ],
      "groupName": "golang"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the default Prefect version constant against PrefectHQ/prefect releases",
      "managerFilePatterns": [
        "/^api/v1/versioning\\.go$/"
      ],
      "matchStrings": [
        "const DEFAULT_PREFECT_VERSION = \"(?<currentValue>.+?)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "PrefectHQ/prefect"
    }
  ]
}
